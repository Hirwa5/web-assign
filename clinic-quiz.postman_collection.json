{
  "info": {
    "name": "Kigali Clinic - JPA & JPQL Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Part A - Derived queries",
      "item": [
        {
          "name": "A1 - Patients by last name",
          "request": { "method": "GET", "url": "http://localhost:8080/api/patients/by-last-name?lastName=uwase" }
        },
        {
          "name": "A2 - Appointments by status",
          "request": { "method": "GET", "url": "http://localhost:8080/api/appointments/by-status?status=SCHEDULED" }
        },
        {
          "name": "A3 - Appointments between dates",
          "request": { "method": "GET", "url": "http://localhost:8080/api/appointments/between?start=2026-10-01&end=2026-10-31" }
        },
        {
          "name": "A4 - No double booking (expect 409)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"appointmentDate\": \"2026-10-20\",\n    \"reason\": \"Checkup\",\n    \"status\": \"SCHEDULED\",\n    \"doctor\": {\n        \"id\": \"f4e9c470-05c3-4c2d-84af-3613d77ac66f\"\n    },\n    \"patient\": {\n        \"id\": \"876e5fbe-9540-41a5-befe-1a519f8c214e\"\n    }\n}"
            },
            "url": "http://localhost:8080/api/appointments/save"
          }
        }
      ]
    },
    {
      "name": "Part B - JPQL with joins",
      "item": [
        {
          "name": "B1 - Doctors by specialization",
          "request": { "method": "GET", "url": "http://localhost:8080/api/doctors/by-specialization?name=cardiology" }
        },
        {
          "name": "B2 - Doctors without an office",
          "request": { "method": "GET", "url": "http://localhost:8080/api/doctors/without-office" }
        },
        {
          "name": "B3 - Specializations nobody offers",
          "request": { "method": "GET", "url": "http://localhost:8080/api/specializations/unused" }
        },
        {
          "name": "B4 - Patients of a doctor",
          "request": { "method": "GET", "url": "http://localhost:8080/api/patients/of-doctor/f4e9c470-05c3-4c2d-84af-3613d77ac66f" }
        }
      ]
    },
    {
      "name": "Part C - Aggregates and bulk updates",
      "item": [
        {
          "name": "C1 - Appointments per status",
          "request": { "method": "GET", "url": "http://localhost:8080/api/appointments/stats/by-status" }
        },
        {
          "name": "C2 - Frequent patients",
          "request": { "method": "GET", "url": "http://localhost:8080/api/patients/frequent?min=3" }
        },
        {
          "name": "C3 - Busiest office",
          "request": { "method": "GET", "url": "http://localhost:8080/api/offices/busiest" }
        },
        {
          "name": "C4 - Doctor is absent",
          "request": { "method": "PATCH", "url": "http://localhost:8080/api/appointments/cancel-day?doctorId=f4e9c470-05c3-4c2d-84af-3613d77ac66f&date=2026-10-20" }
        }
      ]
    }
  ]
